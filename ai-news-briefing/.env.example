# Copy to .env and adjust. .env is gitignored.

# OpenAI-compatible LLM endpoint (oMLX). Either host works; pick the reachable one.
# (key verified 2026-08-29 on both hosts: it is `local-key`, not `local_key`)
AI_NEWS_LLM_BASE_URL=http://localhost:7999/v1
# AI_NEWS_LLM_BASE_URL=http://10.0.0.149:7999/v1
AI_NEWS_LLM_API_KEY=local-key
AI_NEWS_LLM_MODEL=Qwen3.8-27B-4bit
AI_NEWS_LLM_TIMEOUT=180
AI_NEWS_LLM_MAX_TOKENS=4096

# Optional overrides (defaults shown)
# AI_NEWS_OUTPUT_DIR=reports
# AI_NEWS_STATE_FILE=state/seen.json
# AI_NEWS_WINDOW_HOURS=26
# AI_NEWS_MAX_ITEMS=40

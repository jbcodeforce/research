# Confluent Cloud organization / environment
CC_ORG_ID=
CC_ENV_ID=

# Flink SQL REST (regional Flink API key)
FLINK_API_KEY=
FLINK_API_SECRET=
FLINK_CLOUD_PROVIDER=aws
FLINK_CLOUD_REGION=us-east-1
FLINK_COMPUTE_POOL_ID=
FLINK_CATALOG_NAME=
FLINK_DATABASE_NAME=

# Metrics API (Cloud API key or dedicated telemetry key)
TELEMETRY_API_KEY=
TELEMETRY_API_SECRET=

# Optional: OpenAI-compatible LLM for Agno team (--use-agno)
LLM_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:latest
OPENAI_API_KEY=ollama

# Kafka (for perf-testing assets deploy / producer)
BOOTSTRAP_SERVERS=
KAFKA_API_KEY=
KAFKA_API_SECRET=
